        "message": "=<div style=\"font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; background-color: #f4f6f8;\">\n  <div style=\"background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.08); border-top: 6px solid #e63946;\">\n    \n    <!-- Header & Logo Section -->\n    <div style=\"text-align: center; padding: 30px 20px 20px; background-color: #ffffff;\">\n      <img src=\"https://cdn-icons-png.flaticon.com/512/3170/3170733.png\" alt=\"Restaurant Logo\" style=\"max-width: 90px; height: auto; margin-bottom: 10px;\">\n      <h2 style=\"color: #1d3557; margin: 10px 0 0; font-size: 24px; font-weight: 700;\">Thank You for Your Feedback!</h2>\n      <p style=\"color: #e63946; font-size: 14px; font-weight: 600; margin-top: 5px; text-transform: uppercase; letter-spacing: 1px;\">Restaurant Management Team</p>\n    </div>\n\n    <!-- Message Body -->\n    <div style=\"padding: 0 30px 30px; color: #4a5568; line-height: 1.7; font-size: 15px; text-align: left; direction: ltr;\">\n      <p style=\"font-size: 16px; color: #2d3748;\">Dear <strong style=\"color: #1d3557;\">{{ $json[\"Customer Name\"] }}</strong>,</p>\n      \n      <p>Thank you so much for taking the time to share your feedback and experience with us.</p>\n      \n      <!-- Highlight Box -->\n      <div style=\"background-color: #f8f9fa; border-left: 4px solid #e63946; padding: 15px 20px; border-radius: 4px; margin: 20px 0;\">\n        <p style=\"margin: 0; font-style: italic; color: #495057;\">\n          \"Your insights are essential in helping us improve our service and deliver the best dining experience possible.\"\n        </p>\n      </div>\n\n      <p>Our team reviews every piece of feedback carefully, and we look forward to welcoming you back again soon!</p>\n    </div>\n\n    <!-- Footer -->\n    <div style=\"background-color: #1d3557; text-align: center; padding: 20px; color: #ffffff; font-size: 13px;\">\n      <p style=\"margin: 0 0 5px; color: #ffffff; font-weight: 600;\">Customer Support Team</p>\n      <p style=\"margin: 0; opacity: 0.8;\">This is an automated response to confirm receipt of your feedback.</p>\n    </div>\n\n  </div>\n</div>",
