    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const json = item.json;\n  const rating = Number(json.Rating);\n  const feedback = json.Feedback || '';\n\n  // التحقق من صحة التقييم (1-5)\n  const isValidRating = rating >= 1 && rating <= 5;\n\n  // حساب عدد الكلمات\n  const wordCount = feedback.trim() ? feedback.trim().split(/\\s+/).length : 0;\n\n  // حساب عدد الحروف (شاملاً المسافات)\n  const charCount = feedback.length;\n\n  // لحساب عدد الحروف (بدون مسافات)، يمكنك استخدام:\n  // const charCountNoSpaces = feedback.replace(/\\s+/g, '').length;\n\n  return {\n    json: {\n      ...json,\n      ratingValid: isValidRating,\n      wordCount: wordCount,\n      charCount: charCount\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -16,
        0
